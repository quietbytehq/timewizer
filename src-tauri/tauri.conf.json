{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timewizer",
  "version": "0.1.0",
  "identifier": "org.timewizer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Timewizer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Timetables for schools",
    "longDescription": "Timewizer builds school timetables on your own computer. Enter your teachers, classes, rooms and lessons, and it places every lesson so nobody is in two places at once. Works offline.",
    "copyright": "Apache-2.0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "section": "education",
        "priority": "optional"
      }
    },
    "publisher": "Timewizer contributors",
    "fileAssociations": [
      {
        "ext": [
          "twz"
        ],
        "name": "Timewizer school",
        "description": "Timewizer school file",
        "mimeType": "application/x-timewizer",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
